# Privy app id (https://dashboard.privy.io). Leave empty to use the mock session (no real login).
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional Privy app client id, for per-environment settings.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# "mock" (default, no backend needed) or "stellar" (the Soroban contract on testnet through the backend;
# needs NEXT_PUBLIC_PRIVY_APP_ID and NEXT_PUBLIC_API_URL). The stellar client lands in task 6 of KICKOFF_PROMPT.md.
NEXT_PUBLIC_CHAIN_CLIENT=mock

# The kotizi backend (../backend): reads, the sponsored transaction relay, draws, demo onboarding.
NEXT_PUBLIC_API_URL=http://localhost:3001

# TODO(stellar): Soroban RPC URL, network passphrase, contract id.
