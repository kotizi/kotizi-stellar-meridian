# Copy to .env (gitignored). Secret seeds live in key files outside git (e.g. ../keypairs/*.key, gitignored), never here.
NODE_ENV=development
PORT=3001
PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# privy (production) or dev (local only, refused when NODE_ENV=production: tokens are "dev:<G-address>")
AUTH_MODE=privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Stellar testnet only: any other NETWORK_PASSPHRASE is refused at start-up.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# The deployed Kotizi contract (C...), from `stellar contract deploy`.
CONTRACT_ID=

# Role keys are secret seeds (S...). Give each role EITHER a file (*_KEYFILE, e.g. under ../keypairs, gitignored) OR the seed
# itself as a secret variable (*_SECRET, for hosts without files such as Railway); setting both for one role is refused.
# One key may serve several roles. Seeds are never logged.
# Source and fee payer of relayed transactions; also pays account activation.
SPONSOR_KEYFILE=../keypairs/sponsor.key
#SPONSOR_SECRET=S...
# Signs request_draw / settle_draw and pays their fee. Defaults to the sponsor key.
#KEEPER_KEYFILE=../keypairs/keeper.key
#KEEPER_SECRET=S...
# Must be the contract's kyc_authority (set at deploy). Needed for KYC_MODE=auto.
#KYC_KEYFILE=../keypairs/kyc.key
#KYC_SECRET=S...
# Must be the admin of FAUCET_TOKEN (the demo test token). Needed for FAUCET_ENABLED=true.
#MINT_KEYFILE=../keypairs/mint.key
#MINT_SECRET=S...

# Demo onboarding
KYC_MODE=off
FAUCET_ENABLED=false
# The test token (C...) the faucet mints. Real tokens (USDC, USDT0) are never minted by us.
#FAUCET_TOKEN=
FAUCET_AMOUNT_USDC=1000
# XLM a new wallet's account is created with (the base reserve is 1 XLM)
ACCOUNT_ACTIVATION_XLM=2

# Postgres in production; leave empty for embedded PGlite stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.pglite

# Sponsorship limits (stroops; 1 XLM = 10000000)
RELAY_USER_DAILY_TX=100
RELAY_MAX_FEE_STROOPS=10000000
RELAY_GLOBAL_DAILY_STROOPS=1000000000
RELAY_MIN_SPONSOR_STROOPS=100000000
# Ledgers (~5 s) an authorization signature stays valid
RELAY_AUTH_LEDGERS=120

# Draw keeper. DRAND_URL is only a relay: signatures are verified locally and by the contract.
DRAND_URL=https://api.drand.sh
KEEPER_ENABLED=false
KEEPER_INTERVAL_MS=5000

METADATA_IMAGE_URL=https://example.com/kotizi/cota.png
# Postgres for production-like runs. Without it the API uses embedded PGlite.
#   docker compose up -d && DATABASE_URL=postgres://kotizi:kotizi@localhost:5432/kotizi npm start
