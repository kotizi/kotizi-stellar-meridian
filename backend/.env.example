# Copy to .env (gitignored). Secret keys never go in this file's tracked copy and are never logged.
NODE_ENV=development
PORT=3001
PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# privy (production) or dev (local only, refused when NODE_ENV=production: tokens are "dev:<wallet>")
AUTH_MODE=privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Demo onboarding
KYC_MODE=off
FAUCET_ENABLED=false
FAUCET_AMOUNT_USDC=1000

# Postgres in production; leave empty for embedded PGlite stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.pglite

# Sponsorship limits
RELAY_USER_DAILY_TX=100

# Draw keeper
KEEPER_ENABLED=false
KEEPER_INTERVAL_MS=5000

METADATA_IMAGE_URL=https://example.com/kotizi/cota.png

# TODO(stellar), task 5: STELLAR_RPC_URL, NETWORK_PASSPHRASE, CONTRACT_ID, sponsor/KYC/mint secrets.
# Postgres for production-like runs. Without it the API uses embedded PGlite.
#   docker compose up -d && DATABASE_URL=postgres://kotizi:kotizi@localhost:5432/kotizi npm start
